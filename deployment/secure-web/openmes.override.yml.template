# Requires Docker Compose >= 2.24.4. !override prevents retaining old public mappings.
services:
  caddy:
    restart: unless-stopped
    ports: !override
      - target: 80
        published: "80"
        host_ip: 0.0.0.0
        protocol: tcp
      - target: 443
        published: "443"
        host_ip: 0.0.0.0
        protocol: tcp
      - target: 8081
        published: "18081"
        host_ip: 127.0.0.1
        protocol: tcp
    volumes:
      - @@STATE@@/Caddyfile:/etc/caddy/Caddyfile:ro
      - @@ROOT@@/frontend/dist:/srv/auto-parts:ro
      - /run/auto-parts-api:/run/auto-parts-api:ro
