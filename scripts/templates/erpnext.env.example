# 模板：复制为 services/frappe_docker/.env 再填写（deploy_services 脚本会自动复制并提示）。
# 完整变量说明见 services/frappe_docker/example.env 与
# https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md

# ERPNext 镜像版本（与本地验证环境一致）
ERPNEXT_VERSION=v16.36.0

# 【必填】MariaDB root 密码——建站（bench new-site）时要用的就是它。
# 自己设一个强密码，不要用默认值。
DB_PASSWORD=

# 下面三个由 compose 的 mariadb/redis override 提供，保持默认即可：
DB_HOST=db
DB_PORT=3306
REDIS_CACHE=redis-cache:6379
REDIS_QUEUE=redis-queue:6379

# 对外发布端口（本项目的后端配置默认连 http://127.0.0.1:8080，保持一致）
HTTP_PUBLISH_PORT=8080

# 站点名固定为 localhost（后端 ERPNEXT_BASE_URL 按 Host 头访问时由它解析站点）。
# 建站命令（README 第 3.3 节）也用同名站点。
FRAPPE_SITE_NAME_HEADER=localhost
