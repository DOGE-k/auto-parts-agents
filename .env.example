# 本文件是模板：复制为仓库根目录 .env 再填写（.env 被 git 忽略，不会提交）。
#   cp .env.example .env
# 应用本身（backend/app）与 docker-compose.services.yml 共用这一个文件。

APP_ENV=dev
# 业务库：默认 SQLite 零依赖；生产建议 PostgreSQL（见 README 2.1 节 autoparts-db）。
DATABASE_URL=sqlite:///./data/demo.db
SCENARIO_SEED=20260923

# 项目统一登录（人工操作身份）。首次部署时填写密码，后端首次启动会创建账号；
# 用户登录项目后，才可以审批或写入 ERPNext/OpenMES。密码只用于初始化哈希，不提交到仓库。
PROJECT_AUTH_USERNAME=admin
PROJECT_AUTH_PASSWORD=
PROJECT_AUTH_DISPLAY_NAME=项目管理员
PROJECT_AUTH_ROLES=sales_manager,purchase_manager,production_manager,quality_manager
PROJECT_SESSION_TTL_SECONDS=28800
PROJECT_AUTH_COOKIE_SECURE=false

# 前端调用的后端 API 地址（frontend/.env.local 也用这个值，见 README 3.1 节）。
VITE_API_BASE_URL=http://127.0.0.1:9000/api

# 适配器模式（重要）：
#   real — 业务数据只来自真实 ERPNext/OpenMES；任一系统连不上/数据缺失都会
#          明确报错，绝不回退 Mock、不伪造数据（模拟/验收用这个）。
#   auto — 连不上真实系统时回退内置 Mock（仅本地开发调试用，页面数据不是真的）。
APP_ADAPTER_MODE=real
MOCK_DEMO_ENABLED=

# 协同问答（DeepSeek）凭据；未配置时 /assistant/ask 如实返回 503 llm_not_configured。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash

# ERPNext：专用账号 + API Key（用户设置 → API 访问 → 生成密钥）。
# draft_writes 开启后允许创建"草稿"单据（docstatus=0），仍必须走人工审批门禁。
ERPNEXT_BASE_URL=http://127.0.0.1:8080
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_DRAFT_WRITES_ENABLED=true

# OpenMES：两套后端服务凭据。它们不是页面人工登录账号。
#   OPENMES_TOKEN      — 后端用户 API（Bearer），用 backend/get_openmes_token.py 获取；
#                        后端默认开启自动刷新，令牌只用于连接 OpenMES，不作为项目审批身份。
#   OPENMES_ERP_API_KEY— ERP 集成 API（X-Api-Key），同一脚本缺失时会自动创建。
OPENMES_BASE_URL=http://127.0.0.1
OPENMES_TOKEN=
OPENMES_ERP_API_KEY=

# OpenMES 服务端令牌自动刷新（默认开启）：
#   OPENMES_SESSION_AUTO_REFRESH=false 关闭自动重登（令牌过期后需手动重跑 get_openmes_token.py）；
#   OPENMES_SESSION_TTL_SECONDS 内存会话缓存时长（默认 840 秒 = 14 分钟，留 1 分钟 TTL 余量）。
OPENMES_SESSION_AUTO_REFRESH=true
OPENMES_SESSION_TTL_SECONDS=840

# 协同问答会话保留期（天）：原始自然语言消息与协调者运行记录（含中间工具参数）
# 默认 90 天后由后端惰性清理；设为 0 表示永久保留。
# 业务审批、采购方案、ERP/MES 写入记录、回读/幂等证据与业务任务摘要始终永久保留。
ASSISTANT_RETENTION_DAYS=90

# 部署级兼容写入令牌（可选）：如果填写，错误的 X-Real-Write-Token 会被拒绝；
# 普通业务写入只要求项目账号会话，不需要把这个值填到页面。它不代表人工审批身份。
REAL_WRITE_API_TOKEN=

# 未登录时只读连接状态的上游身份来源：auto 先试 ERPNext 再试 OpenMES；
# 真实审批和 ERP/MES 写入统一使用上面的项目登录会话。角色映射仅用于上游只读身份兼容。
REAL_IDENTITY_PROVIDER=auto
REAL_IDENTITY_ROLE_MAP=

# ---------- 以下为可选/外部依赖项，留空即可运行 ----------

# docker-compose.services.yml 专用（ERPNext 容器组）：
#   ERPNEXT_VERSION=v16.36.0
#   DB_PASSWORD=<给 ERPNext MariaDB 设一个密码>
#   DB_HOST=db
#   DB_PORT=3306
#   REDIS_CACHE=redis-cache:6379
#   REDIS_QUEUE=redis-queue:6379
#   HTTP_PUBLISH_PORT=8080
# OpenMES 容器组：APP_KEY 缺省时由其入口脚本首启自动生成；其余变量默认值见
#   services/OpenMes/docker-compose.yml 顶部注释与 services/OpenMes/.env.example。

# 可选 ACPs/Wutong 发现（只读）。Registry 写路径保持禁用，等部署方鉴权/租户契约。
WUTONG_REGISTRY_URL=
WUTONG_DISCOVERY_URL=
WUTONG_TENANT=
QUOTATION_AIC=
PROCUREMENT_AIC=
TRACKING_AIC=
QUALITY_DOCUMENT_AIC=
ACPS_CA_CERT_FILE=
ACPS_CLIENT_CERT_FILE=
ACPS_CLIENT_KEY_FILE=
