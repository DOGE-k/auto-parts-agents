APP_ENV=dev
DATABASE_URL=sqlite:///./data/demo.db
SCENARIO_SEED=20260923
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Real provider: credentials are read from the local, git-ignored .env file.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash

# ERPNext uses a dedicated account with only the minimum DocType permissions.
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_DRAFT_WRITES_ENABLED=false

# OpenMES user token and ERP integration key are different credentials.
OPENMES_BASE_URL=
OPENMES_TOKEN=
OPENMES_ERP_API_KEY=

# Real approval identity is resolved from the configured upstream account.
# auto tries ERPNext first and OpenMES second. Optional role mapping is JSON.
REAL_IDENTITY_PROVIDER=auto
REAL_IDENTITY_ROLE_MAP=

# Wutong registration is intentionally deferred until the local agents work.
WUTONG_REGISTRY_URL=
WUTONG_DISCOVERY_URL=
WUTONG_TENANT=
QUOTATION_AIC=
PROCUREMENT_AIC=
TRACKING_AIC=
QUALITY_DOCUMENT_AIC=
ACPS_CA_CERT_FILE=
ACPS_CLIENT_CERT_FILE=
ACPS_CLIENT_KEY_FILE=
